{
  "name": "lamX codespaces",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "privileged": true,
  "onCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq qemu-system-x86 qemu-utils novnc websockify",
  "postCreateCommand": "[ -f ~/lamX-2026.09.09-x86_64.iso ] || curl -L -C - -o ~/lamX-2026.09.09-x86_64.iso https://github.com/NaveenSingh9999/lamX/releases/download/v1.6/lamX-2026.09.09-x86_64.iso",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "lamX noVNC",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
