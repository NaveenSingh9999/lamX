(defvar EWW_MUSIC "")
(defpoll EWW_MUSIC :interval "5s" :initial ""
  "playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null | cut -c1-48 || echo ''")
(defwidget clock []
  (box :orientation "vertical" :halign "center" :valign "center" :spacing 4
    (label :class "clock-time" :text {formattime(EWW_TIME, "%H:%M")})
    (label :class "clock-date" :text {formattime(EWW_TIME, "%A %d %B")})
    (label :class "clock-music" :text {EWW_MUSIC})))
(defwindow clock :monitor 0 :geometry (geometry :x "0px" :y "-12%"
  :width "100%" :height "300px" :anchor "center") :stacking "bg"
  :exclusive false :focusable false :class "clock-win" (clock))
