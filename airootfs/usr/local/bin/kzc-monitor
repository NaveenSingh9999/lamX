#!/usr/bin/env python3
"""KZC monitor - on-device statistical AI, no LLM, no network, no API.
Watches proc, modules, persist paths, USB. Learns baselines, z-score alerts.
Open source stack: auditd + AppArmor + this daemon. Runs 24/7, self-protecting."""
import json
import os
import sys
import time
import hashlib
import collections
import subprocess
import math

CONF = "/etc/kzc/config.toml"
STATE = "/var/lib/kzc/baseline.json"
LOG = "/var/log/kzc/kzc.log"
FIFO = "/var/lib/kzc/alerts.fifo"
QUAR = "/var/lib/kzc/quarantine"

PERSIST = ["/etc/systemd/system", "/etc/cron.d", "/etc/modprobe.d", "/boot"]
WINDOW = 300
Z_THRESH = 3.5

def log(msg):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as f:
        f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {msg}\n")

def alert(text):
    log(f"ALERT {text}")
    try:
        os.makedirs(os.path.dirname(FIFO), exist_ok=True)
        if not os.path.exists(FIFO):
            os.mkfifo(FIFO)
        fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)
        os.write(fd, (text + "\n").encode())
        os.close(fd)
    except Exception:
        pass
    try:
        subprocess.run(["notify-send", "-u", "critical", "Security", text], timeout=2)
    except Exception:
        pass

def load_baseline():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return {"exec_counts": {}, "samples": 0}

def save_baseline(b):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(b, f)
    os.rename(tmp, STATE)

def proc_snapshot():
    pairs = collections.Counter()
    pids = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/comm") as f:
                name = f.read().strip()
            with open(f"/proc/{pid}/stat") as f:
                ppid = f.read().split()[3]
            pname = "?"
            try:
                with open(f"/proc/{ppid}/comm") as f:
                    pname = f.read().strip()
            except Exception:
                pass
            pairs[(pname, name)] += 1
            pids[pid] = (pname, name)
        except Exception:
            continue
    return pairs, pids

def zscore(x, mean, std):
    if std == 0:
        return 0 if x == mean else 99
    return abs(x - mean) / std

def file_hash(p):
    try:
        h = hashlib.sha256()
        with open(p, "rb") as f:
            for chunk in iter(lambda: f.read(65536), b""):
                h.update(chunk)
        return h.hexdigest()[:16]
    except Exception:
        return None

def scan_persist(known):
    changed = []
    for root in PERSIST:
        if not os.path.isdir(root):
            continue
        for dp, _, fns in os.walk(root):
            for fn in fns:
                p = os.path.join(dp, fn)
                hh = file_hash(p)
                if hh is None:
                    continue
                if p not in known:
                    known[p] = hh
                    changed.append(f"new:{p}")
                elif known[p] != hh:
                    known[p] = hh
                    changed.append(f"mod:{p}")
    return changed

def quarantine(p):
    try:
        os.makedirs(QUAR, exist_ok=True)
        base = os.path.basename(p)
        dst = os.path.join(QUAR, f"{int(time.time())}-{base}")
        os.chmod(p, 0)
        os.rename(p, dst)
        log(f"quarantined {p} -> {dst}")
    except Exception as e:
        log(f"quarantine fail {p}: {e}")

def main():
    baseline = load_baseline()
    counts = collections.Counter(baseline.get("exec_counts", {}))
    samples = baseline.get("samples", 0)
    fknown = baseline.get("files", {})
    mod_known = set()
    try:
        with open("/proc/modules") as f:
            mod_known = set(l.split()[0] for l in f)
    except Exception:
        pass
    log("KZC start, samples=%d" % samples)
    while True:
        try:
            pairs, pids = proc_snapshot()
            samples += 1
            # learn + detect: compare current pair rate vs running mean
            for pair, c in pairs.items():
                key = f"{pair[0]}>{pair[1]}"
                prev = counts.get(key, 0)
                mean = prev / max(samples, 1)
                # simple running std approx via sqrt(mean) for counts
                std = math.sqrt(mean + 1)
                z = zscore(c, mean, std)
                counts[key] = prev + c
                if samples > 50 and z > Z_THRESH and c >= 2:
                    # allowlist: expected sway children
                    if pair in {("sway", "foot"), ("sway", "wofi"), ("sway", "waybar")}:
                        continue
                    alert(f"anomaly exec {key} x{c} z={z:.1f}")
                    # kill shell escapes from GUI apps
                    if pair[0] in ("librewolf", "wofi", "waybar") and pair[1] in ("bash", "sh", "zsh"):
                        for pid, (pn, n) in pids.items():
                            if pn == pair[0] and n == pair[1]:
                                try:
                                    os.kill(int(pid), 9)
                                    log(f"killed {pid} {key}")
                                except Exception:
                                    pass
            # module loads
            try:
                with open("/proc/modules") as f:
                    cur = set(l.split()[0] for l in f)
                newmod = cur - mod_known
                for m in newmod:
                    if m not in ("uvcvideo", "btusb", "iwlwifi", "nvidia"):
                        alert(f"new kernel module: {m}")
                mod_known = cur
            except Exception:
                pass
            # persist integrity
            for ch in scan_persist(fknown):
                alert(f"persist change {ch}")
                if ch.startswith("new:") and ch.endswith((".sh", ".service", ".timer")):
                    quarantine(ch[4:])
            # USB storage watch
            try:
                for dev in os.listdir("/sys/block"):
                    if dev.startswith(("sd", "nvme")):
                        ue = f"/sys/block/{dev}/device/uevent"
                        try:
                            with open(ue) as f:
                                if "USB" in f.read():
                                    alert(f"usb block device: {dev}")
                        except Exception:
                            pass
            except Exception:
                pass
            if samples % 12 == 0:
                save_baseline({"exec_counts": dict(counts), "samples": samples, "files": fknown})
            time.sleep(10)
        except Exception as e:
            log(f"loop err: {e}")
            time.sleep(10)

if __name__ == "__main__":
    sys.exit(main())
