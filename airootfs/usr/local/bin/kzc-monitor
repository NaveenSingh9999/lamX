#!/usr/bin/env python3
"""KZC monitor v2 - on-device statistical AI, no LLM, no network, no API.
Upgrades: allowlist, suspect scoring with decay, alert rate-limit,
quarantine manifest with restore, self-integrity check.
Stack: auditd + AppArmor + this daemon. Runs 24/7, self-protecting."""
import json
import os
import sys
import time
import hashlib
import collections
import subprocess
import math

STATE = "/var/lib/kzc/baseline.json"
SUSPECTS = "/var/lib/kzc/suspects.json"
LOG = "/var/log/kzc/kzc.log"
FIFO = "/var/lib/kzc/alerts.fifo"
QUAR = "/var/lib/kzc/quarantine"
QMAN = "/var/lib/kzc/quarantine.json"
ALLOW = "/etc/kzc/allowlist.conf"
SELF = "/usr/local/bin/kzc-monitor"

PERSIST = ["/etc/systemd/system", "/etc/cron.d", "/etc/modprobe.d", "/boot"]
WINDOW = 10
Z_THRESH = 3.5
RATE_LIMIT = 300
DECAY_EVERY = 6

_last_alert = {}

def log(msg):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as f:
        f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {msg}\n")

def rate_ok(key):
    now = time.time()
    if now - _last_alert.get(key, 0) < RATE_LIMIT:
        return False
    _last_alert[key] = now
    return True

def alert(text, key=None):
    log(f"ALERT {text}")
    if key and not rate_ok(key):
        return
    try:
        os.makedirs(os.path.dirname(FIFO), exist_ok=True)
        if not os.path.exists(FIFO):
            os.mkfifo(FIFO)
        fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)
        os.write(fd, (text + "\n").encode())
        os.close(fd)
    except Exception:
        pass
    try:
        subprocess.run(["notify-send", "-u", "critical", "Security", text], timeout=2)
    except Exception:
        pass

def load_json(p, default):
    try:
        with open(p) as f:
            return json.load(f)
    except Exception:
        return default

def save_json(p, obj):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    tmp = p + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.rename(tmp, p)

def load_allow():
    try:
        with open(ALLOW) as f:
            return {l.strip() for l in f if l.strip() and not l.startswith("#")}
    except Exception:
        return set()

def proc_snapshot():
    pairs = collections.Counter()
    pids = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/comm") as f:
                name = f.read().strip()
            with open(f"/proc/{pid}/stat") as f:
                ppid = f.read().split()[3]
            pname = "?"
            try:
                with open(f"/proc/{ppid}/comm") as f:
                    pname = f.read().strip()
            except Exception:
                pass
            pairs[(pname, name)] += 1
            pids[pid] = (pname, name)
        except Exception:
            continue
    return pairs, pids

def file_hash(p):
    try:
        h = hashlib.sha256()
        with open(p, "rb") as f:
            for chunk in iter(lambda: f.read(65536), b""):
                h.update(chunk)
        return h.hexdigest()[:16]
    except Exception:
        return None

def scan_persist(known):
    changed = []
    for root in PERSIST:
        if not os.path.isdir(root):
            continue
        for dp, _, fns in os.walk(root):
            for fn in fns:
                p = os.path.join(dp, fn)
                hh = file_hash(p)
                if hh is None:
                    continue
                if p not in known:
                    known[p] = hh
                    changed.append(f"new:{p}")
                elif known[p] != hh:
                    known[p] = hh
                    changed.append(f"mod:{p}")
    return changed

def quarantine(p):
    try:
        os.makedirs(QUAR, exist_ok=True)
        man = load_json(QMAN, {})
        base = os.path.basename(p)
        dst = os.path.join(QUAR, f"{int(time.time())}-{base}")
        os.chmod(p, 0)
        os.rename(p, dst)
        man[dst] = p
        save_json(QMAN, man)
        log(f"quarantined {p} -> {dst}")
    except Exception as e:
        log(f"quarantine fail {p}: {e}")

def bump_suspect(suspects, key, weight=1):
    s = suspects.get(key, {"score": 0, "count": 0, "first": time.time(), "last": 0})
    s["score"] += weight
    s["count"] += 1
    s["last"] = time.time()
    suspects[key] = s
    return s["score"]

def main():
    baseline = load_json(STATE, {})
    suspects = load_json(SUSPECTS, {})
    counts = collections.Counter(baseline.get("exec_counts", {}))
    samples = baseline.get("samples", 0)
    fknown = baseline.get("files", {})
    allow = load_allow()
    self_hash = file_hash(SELF)
    mod_known = set()
    try:
        with open("/proc/modules") as f:
            mod_known = set(l.split()[0] for l in f)
    except Exception:
        pass
    log("KZC v2 start, samples=%d suspects=%d" % (samples, len(suspects)))
    tick = 0
    while True:
        try:
            tick += 1
            if tick % DECAY_EVERY == 0:
                for k in list(suspects):
                    suspects[k]["score"] = max(0, suspects[k]["score"] - 1)
                    if suspects[k]["score"] == 0 and time.time() - suspects[k]["last"] > 86400:
                        del suspects[k]
            if file_hash(SELF) != self_hash:
                alert("KZC binary modified, possible tampering", key="self")
            pairs, pids = proc_snapshot()
            samples += 1
            for pair, c in pairs.items():
                key = f"{pair[0]}>{pair[1]}"
                if key in allow:
                    continue
                prev = counts.get(key, 0)
                mean = prev / max(samples, 1)
                std = math.sqrt(mean + 1)
                z = 0 if std == 0 else abs(c - mean) / std
                counts[key] = prev + c
                if samples > 50 and z > Z_THRESH and c >= 2:
                    score = bump_suspect(suspects, key)
                    alert(f"anomaly exec {key} x{c} z={z:.1f} score={score}", key=f"exec:{key}")
                    if pair[0] in ("librewolf", "wofi", "waybar") and pair[1] in ("bash", "sh", "zsh"):
                        for pid, (pn, n) in pids.items():
                            if pn == pair[0] and n == pair[1]:
                                try:
                                    os.kill(int(pid), 9)
                                    log(f"killed {pid} {key}")
                                except Exception:
                                    pass
            try:
                with open("/proc/modules") as f:
                    cur = set(l.split()[0] for l in f)
                for m in cur - mod_known:
                    if m not in ("uvcvideo", "btusb", "iwlwifi", "nvidia"):
                        bump_suspect(suspects, f"module:{m}", 2)
                        alert(f"new kernel module: {m}", key=f"mod:{m}")
                mod_known = cur
            except Exception:
                pass
            for ch in scan_persist(fknown):
                bump_suspect(suspects, ch, 2)
                alert(f"persist change {ch}", key=f"persist:{ch}")
                if ch.startswith("new:") and ch.endswith((".sh", ".service", ".timer")):
                    quarantine(ch[4:])
            try:
                for dev in os.listdir("/sys/block"):
                    if dev.startswith(("sd", "nvme")):
                        try:
                            with open(f"/sys/block/{dev}/device/uevent") as f:
                                if "USB" in f.read():
                                    alert(f"usb block device: {dev}", key=f"usb:{dev}")
                        except Exception:
                            pass
            except Exception:
                pass
            if samples % 12 == 0:
                save_json(STATE, {"exec_counts": dict(counts), "samples": samples, "files": fknown})
                save_json(SUSPECTS, suspects)
            time.sleep(WINDOW)
        except Exception as e:
            log(f"loop err: {e}")
            time.sleep(WINDOW)

if __name__ == "__main__":
    sys.exit(main())
