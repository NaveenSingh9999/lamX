#!/usr/bin/env bash
set -euo pipefail
# kzc-notify - bridge KZC alerts to user, Sway + terminal
FIFO="/var/lib/kzc/alerts.fifo"
[ -p "$FIFO" ] || mkfifo "$FIFO"
while read -r line < "$FIFO"; do
  [ -n "$line" ] || continue
  notify-send -u critical "KZC" "$line" || true
  echo "[KZC] $line" | wall || true
  logger -t kzc "$line" || true
done
