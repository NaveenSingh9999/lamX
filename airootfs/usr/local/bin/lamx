#!/usr/bin/env bash
set -euo pipefail
# lamx - private hardware disconnect at kernel level
# usage: lamx list | lamx status | lamx disable <component> | lamx enable <component>
# components: camera wifi bluetooth mic speakers usb ethernet nvidia
STATE_DIR="/etc/lamx/disabled"
MOD_DIR="/etc/modprobe.d"
RFKILL_BIN="$(command -v rfkill || true)"

declare -A MODS=(
  [camera]="uvcvideo videodev videobuf2_vmalloc videobuf2_memops videobuf2_v4l2 videobuf2_common"
  [wifi]="iwlwifi iwlmei iwlmvm ath9k ath10k_pci ath11k_pci mt76 mt7921e brcmfmac rtw88_pci"
  [bluetooth]="btusb bluetooth btrtl btintel btbcm bnep"
  [mic]="snd_usb_audio snd_usbmidi_lib"
  [speakers]="snd_hda_codec_hdmi snd_hda_intel snd_soc_core"
  [usb]="usb_storage uas"
  [ethernet]="r8169 e1000e igc atlantic"
  [nvidia]="nvidia nvidia_modeset nvidia_uvm nouveau"
)

mkdir -p "$STATE_DIR"

list_components() {
  for k in camera wifi bluetooth mic speakers usb ethernet nvidia; do echo "$k"; done
}

is_disabled() {
  [ -f "$STATE_DIR/$1" ]
}

comp_status() {
  local c="$1"
  if is_disabled "$c"; then echo "disabled"; else echo "active"; fi
}

do_list() {
  printf "%-10s %s\n" "COMPONENT" "STATE"
  for c in $(list_components); do
    printf "%-10s %s\n" "$c" "$(comp_status "$c")"
  done
  echo ""
  echo "devices:"
  ls /dev/video* 2>/dev/null || echo "  no /dev/video*"
  [ -n "$RFKILL_BIN" ] && rfkill list || true
  echo ""
  echo "loaded lamx modules:"
  lsmod | grep -E "uvcvideo|iwlwifi|bluetooth|btusb|snd_usb_audio|nvidia|nouveau" || echo "  none"
}

kernel_block() {
  local c="$1"
  local mods="${MODS[$c]:-}"
  if [ "$c" = "wifi" ] && [ -n "$RFKILL_BIN" ]; then rfkill block wifi || true; fi
  if [ "$c" = "bluetooth" ] && [ -n "$RFKILL_BIN" ]; then rfkill block bluetooth || true; fi
  # unbind USB camera / bluetooth / wifi where possible
  if [ "$c" = "camera" ]; then
    for d in /sys/bus/usb/drivers/uvcvideo/*; do
      [ -e "$d" ] || continue
      echo "$(basename "$d")" > /sys/bus/usb/drivers/uvcvideo/unbind 2>/dev/null || true
    done
  fi
  for m in $mods; do
    modprobe -r "$m" 2>/dev/null || true
    echo "blacklist $m" > "$MOD_DIR/lamx-$c-$m.conf"
  done
  touch "$STATE_DIR/$c"
}

kernel_unblock() {
  local c="$1"
  local mods="${MODS[$c]:-}"
  rm -f "$MOD_DIR/lamx-$c-"*.conf
  rm -f "$STATE_DIR/$c"
  for m in $mods; do
    modprobe "$m" 2>/dev/null || true
  done
  if [ "$c" = "wifi" ] && [ -n "$RFKILL_BIN" ]; then rfkill unblock wifi || true; fi
  if [ "$c" = "bluetooth" ] && [ -n "$RFKILL_BIN" ]; then rfkill unblock bluetooth || true; fi
  # rescan USB for camera
  if [ "$c" = "camera" ]; then
    echo 1 > /sys/bus/usb/rescan 2>/dev/null || true
  fi
}

case "${1:-list}" in
  list|status)
    do_list
    ;;
  disable)
    c="${2:-}"; [ -n "$c" ] || { echo "usage: lamx disable <component>"; exit 1; }
    [[ -v MODS[$c] ]] || { echo "unknown: $c"; echo "valid: ${!MODS[@]}"; exit 1; }
    kernel_block "$c"
    echo "$c disabled at kernel level."
    ;;
  enable)
    c="${2:-}"; [ -n "$c" ] || { echo "usage: lamx enable <component>"; exit 1; }
    [[ -v MODS[$c] ]] || { echo "unknown: $c"; exit 1; }
    kernel_unblock "$c"
    echo "$c enabled."
    ;;
  *)
    echo "usage: lamx list | lamx disable <component> | lamx enable <component>"
    exit 1
    ;;
esac
