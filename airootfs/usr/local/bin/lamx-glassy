#!/usr/bin/env bash
set -euo pipefail
# lamx-glassy - enable full blur after swayfx is installed post-boot
# usage: sudo lamx-glassy on
if ! command -v swayfx >/dev/null 2>&1 && [ ! -f /usr/bin/swayfx ]; then
  echo "install swayfx first via chaotic-aur, then run again"
  exit 1
fi
grep -q "config.d/fx" /etc/sway/config.d/lamx || echo "include /etc/sway/config.d/fx" >> /etc/sway/config.d/lamx
echo "glassy enabled. Restart Sway."
