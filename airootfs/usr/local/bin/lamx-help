#!/usr/bin/env bash
# help - neutral, no OS identifiers
cat <<'EOF'
commands:
  lamx list | disable <c> | enable <c>   hardware disconnect at kernel level
    components: camera wifi bluetooth mic speakers usb ethernet nvidia
  lamx-prompt <cmd>                      run restricted command with approval prompt
  lamx-vpn on|off|status                 optional VPN killswitch, off by default
  lamx-backup /mnt/backup                encrypted snapshot backup
  lamx-wipe /dev/disk                    secure erase, asks ERASE
  lamx-help                              this help

music:
  lamx-music [terms]                     stream YouTube audio, wofi in GUI
  lamx-music -q [terms]                  queue mode, -s subscriptions
  media keys play, next, prev work in both sessions. Mod+M opens music.

xtreme:
  sudo lamx-xtreme on|off|status         max limits for heavy tasks, AC only
  unleashed boot entry                   no CPU mitigations, picked at boot

vms:
  quickemu --vm ubuntu.conf --display spice   fastest ISO test, QEMU direct
  virt-manager                           full GUI manager with TPM and UEFI

security:
  lamx-kzc status|suspects|logs|quarantine   inspect KZC
  lamx-kzc allow 'p>child' | restore [file]  tune and recover
  kzc-dashboard                          local GUI in browser

phone:
  lamx-phone link user@ip | push|pull|notify|status   SSH only, no cloud

sync and wake:
  lamx-sync status|ui|pause|resume     syncthing, pair phone app via device ID
  lamx-sync wake <mac>                 Wake-on-LAN, needs wired plus BIOS WoL
  lamx-sync wol-check [iface]          verify NIC supports magic packet

keys:
  boot: PIN + TPM. lock and sudo: touch phone key, fallback PIN + Aegis code.
  enroll phone: pamu2fcfg -u $USER >> /etc/pam-u2f/authfile
  enroll hardware key later: same command with key inserted.

session:
  Sway default for battery. Hyprland at login for smooth animations.
  Keys same both: Mod+Enter terminal, Mod+D launcher, Mod+Shift+E exit.
  auto-lock 60s. lid close locks.
EOF
