#!/usr/bin/env bash
set -euo pipefail
# lamx-wipe - secure erase, requires typed confirmation
# usage: sudo lamx-wipe /dev/nvme0n1
[ "$EUID" -eq 0 ] || exec sudo "$0" "$@"
DISK="${1:-}"
[ -n "$DISK" ] || { echo "usage: sudo lamx-wipe /dev/disk"; exit 1; }
echo "THIS DESTROYS ALL DATA ON $DISK"
read -rp "type ERASE to continue: " c
[ "$c" = "ERASE" ] || exit 1
cryptsetup erase "$DISK" || true
blkdiscard -f "$DISK" || wipefs -a "$DISK"
echo "wiped $DISK"
