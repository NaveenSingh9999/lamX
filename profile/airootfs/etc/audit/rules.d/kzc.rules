## KZC kernel audit - open source auditd, immutable
-w /etc/shadow -p wa -k kzc-identity
-w /etc/passwd -p wa -k kzc-identity
-w /etc/sudoers -p wa -k kzc-priv
-w /etc/sudoers.d/ -p wa -k kzc-priv
-w /etc/polkit-1/rules.d/ -p wa -k kzc-priv
-w /etc/modprobe.d/ -p wa -k kzc-kernel
-w /etc/systemd/system/ -p wa -k kzc-persist
-w /etc/cron.d/ -p wa -k kzc-persist
-w /boot/ -p wa -k kzc-boot
-a always,exit -F arch=b64 -S init_module,finit_module,create_module -k kzc-module
-a always,exit -F arch=b64 -S ptrace -k kzc-ptrace
-a always,exit -F arch=b64 -S mount,umount2 -k kzc-mount
-w /usr/local/bin/lamx -p wa -k kzc-lamx
-w /usr/local/bin/kzc-monitor -p wa -k kzc-self
-w /etc/kzc/ -p wa -k kzc-self
-e 2
