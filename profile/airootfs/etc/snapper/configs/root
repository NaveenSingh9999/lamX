# snapper root config - Btrfs @ subvolume
SUBVOLUME="/"
FSTYPE="btrfs"
QGROUP="1/0"
SPACE_LIMIT="0.5"
FREE_LIMIT="0.2"
ALLOW_USERS=""
SYNC_ACL="yes"
BACKGROUND_COMPARISON="yes"
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="5"
TIMELINE_LIMIT_DAILY="7"
TIMELINE_LIMIT_WEEKLY="2"
TIMELINE_LIMIT_MONTHLY="1"
