{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 6,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": ["wlr/workspaces", "sway/mode"],
  "modules-center": ["clock"],
  "modules-right": ["custom/privacy", "pulseaudio", "network", "battery", "tray"],
  "wlr/workspaces": { "format": "{icon}", "format-icons": { "1": "1", "2": "2", "3": "3", "4": "4" } },
  "clock": { "format": "{:%H:%M  %d-%m}", "tooltip-format": "{:%A %d %B}" },
  "battery": { "format": "{capacity}% {icon}", "format-icons": ["", "", "", "", ""] },
  "network": { "format-wifi": " {signalStrength}%", "format-ethernet": "", "format-disconnected": "" },
  "pulseaudio": { "format": "{volume}% ", "format-muted": "" },
  "custom/privacy": { "exec": "lamx-eye --json", "interval": 2, "return-type": "json", "on-click": "foot lamx-eye" }
}
