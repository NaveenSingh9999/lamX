#!/usr/bin/env python3
"""kzc-dashboard - local GUI for KZC. stdlib HTTP on loopback, opens browser."""
import json, os, subprocess, time, urllib.parse
from http.server import BaseHTTPRequestHandler, HTTPServer
from datetime import datetime

BASE = "/var/lib/kzc"
LOG = "/var/log/kzc/kzc.log"
HTML = "/usr/share/kzc/dashboard.html"

def load(p, d):
    try:
        with open(p) as f:
            return json.load(f)
    except Exception:
        return d

def svc(name):
    try:
        r = subprocess.run(["systemctl", "is-active", name], capture_output=True, text=True, timeout=3)
        return r.stdout.strip()
    except Exception:
        return "unknown"

class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass
    def page(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/html")
        self.end_headers()
        with open(HTML, "rb") as f:
            self.wfile.write(f.read())
    def api(self):
        if self.path == "/api/summary":
            sus = load(f"{BASE}/suspects.json", {})
            man = load(f"{BASE}/quarantine.json", {})
            base = load(f"{BASE}/baseline.json", {})
            try:
                with open(LOG) as f:
                    lines = f.read().splitlines()[-40:]
            except Exception:
                lines = []
            try:
                with open("/etc/kzc/allowlist.conf") as f:
                    allow = f.read()
            except Exception:
                allow = ""
            try:
                with open("/etc/kzc/config.toml") as f:
                    conf = f.read()
            except Exception:
                conf = ""
            out = {
                "services": [["kzc-monitor", svc("kzc-monitor")], ["kzc-notify", svc("kzc-notify")],
                             ["auditd", svc("auditd")], ["opencode-kzc", svc("opencode-kzc")]],
                "samples": base.get("samples", 0),
                "suspects": [{"key": k, "score": v["score"], "count": v["count"],
                              "last": datetime.fromtimestamp(v["last"]).strftime("%m-%d %H:%M")} for k, v in
                             sorted(sus.items(), key=lambda i: -i[1]["score"])[:30]],
                "quarantine": [{"dst": d, "src": s} for d, s in man.items()],
                "log": [l for l in lines if "ALERT" in l][-25:],
                "config": allow + "\n---\n" + conf,
            }
            body = json.dumps(out).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(body)
        else:
            self.send_response(404)
            self.end_headers()
    def do_GET(self):
        (self.api() if self.path.startswith("/api/") else self.page())
    def do_POST(self):
        ln = int(self.headers.get("Content-Length", 0))
        form = urllib.parse.parse_qs(self.rfile.read(ln).decode())
        if self.path == "/api/allow" and form.get("pair"):
            with open("/etc/kzc/allowlist.conf", "a") as f:
                f.write(form["pair"][0].strip() + "\n")
        elif self.path == "/api/restore" and form.get("dst"):
            subprocess.run(["lamx-kzc", "restore", form["dst"][0]], timeout=15)
        self.send_response(303)
        self.send_header("Location", "/")
        self.end_headers()

srv = HTTPServer(("127.0.0.1", 8765), H)
subprocess.Popen(["xdg-open", "http://127.0.0.1:8765/"],
                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
print("dashboard at http://127.0.0.1:8765, Ctrl-C stops")
try:
    srv.serve_forever()
except KeyboardInterrupt:
    pass
