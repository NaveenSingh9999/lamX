#!/usr/bin/env python3
"""KZC monitor v3 - layered on-device detection. No LLM, no network, no API.
Sensors: proc scan, module set, persist hashes, USB, net conns, audit denials.
Brain: multi-window EWMA baselines, rarity store, priv-chain rules, quorum.
Act: score, quarantine with manifest, kill escapes, lock session on critical."""
import json
import os
import sys
import time
import hashlib
import collections
import subprocess
import math

BASE = "/var/lib/kzc"
STATE = f"{BASE}/baseline.json"
SUSPECTS = f"{BASE}/suspects.json"
RARITY = f"{BASE}/rarity.json"
LOG = "/var/log/kzc/kzc.log"
FIFO = f"{BASE}/alerts.fifo"
QUAR = f"{BASE}/quarantine"
QMAN = f"{BASE}/quarantine.json"
ALLOW = "/etc/kzc/allowlist.conf"
SELF = "/usr/local/bin/kzc-monitor"
AUDIT_LOG = "/var/log/audit/audit.log"

PERSIST = ["/etc/systemd/system", "/etc/cron.d", "/etc/modprobe.d", "/boot"]
WINDOWS = {"1m": 60, "5m": 300, "1h": 3600}
Z_THRESH = 3.5
ALPHA = 0.2
QUORUM = 2
RATE_LIMIT = 300
CHAIN = [
    ({"librewolf", "wofi", "waybar"}, {"bash", "sh", "zsh"}, 5, "shell escape from GUI"),
    ({"bash", "sh", "zsh"}, {"sudo", "doas"}, 2, "priv escalation after shell"),
    ({"sudo", "doas", "pkexec"}, {"modprobe", "insmod"}, 5, "module load via priv"),
]

_last_alert = {}

def log(msg):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as f:
        f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {msg}\n")

def rate_ok(key):
    now = time.time()
    if now - _last_alert.get(key, 0) < RATE_LIMIT:
        return False
    _last_alert[key] = now
    return True

def alert(text, key=None):
    log(f"ALERT {text}")
    if key and not rate_ok(key):
        return
    try:
        os.makedirs(os.path.dirname(FIFO), exist_ok=True)
        if not os.path.exists(FIFO):
            os.mkfifo(FIFO)
        fd = os.open(FIFO, os.O_WRONLY | os.O_NONBLOCK)
        os.write(fd, (text + "\n").encode())
        os.close(fd)
    except Exception:
        pass
    try:
        subprocess.run(["notify-send", "-u", "critical", "Security", text], timeout=2)
    except Exception:
        pass

def lock_session():
    try:
        subprocess.run(["loginctl", "lock-sessions"], timeout=5)
    except Exception:
        pass

def load_json(p, default):
    try:
        with open(p) as f:
            return json.load(f)
    except Exception:
        return default

def save_json(p, obj):
    os.makedirs(os.path.dirname(p), exist_ok=True)
    tmp = p + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.rename(tmp, p)

def pacman_active():
    return os.path.exists("/var/lib/pacman/db.lck")

def proc_snapshot():
    pairs = collections.Counter()
    pids = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/comm") as f:
                name = f.read().strip()
            with open(f"/proc/{pid}/stat") as f:
                ppid = f.read().split()[3]
            pname = "?"
            try:
                with open(f"/proc/{ppid}/comm") as f:
                    pname = f.read().strip()
            except Exception:
                pass
            pairs[(pname, name)] += 1
            pids[pid] = (pname, name)
        except Exception:
            continue
    return pairs, pids

def net_conns():
    out = set()
    for proto in ("tcp", "tcp6", "udp", "udp6"):
        try:
            with open(f"/proc/net/{proto}") as f:
                lines = f.read().splitlines()[1:]
            for ln in lines:
                p = ln.split()
                if len(p) > 3 and p[3] == "01":
                    out.add(p[2])
        except Exception:
            pass
    return out

def file_hash(p):
    try:
        h = hashlib.sha256()
        with open(p, "rb") as f:
            for chunk in iter(lambda: f.read(65536), b""):
                h.update(chunk)
        return h.hexdigest()[:16]
    except Exception:
        return None

def scan_persist(known):
    changed = []
    for root in PERSIST:
        if not os.path.isdir(root):
            continue
        for dp, _, fns in os.walk(root):
            for fn in fns:
                p = os.path.join(dp, fn)
                hh = file_hash(p)
                if hh is None:
                    continue
                if p not in known:
                    known[p] = hh
                    changed.append(f"new:{p}")
                elif known[p] != hh:
                    known[p] = hh
                    changed.append(f"mod:{p}")
    return changed

def quarantine(p):
    try:
        os.makedirs(QUAR, exist_ok=True)
        man = load_json(QMAN, {})
        dst = os.path.join(QUAR, f"{int(time.time())}-{os.path.basename(p)}")
        os.chmod(p, 0)
        os.rename(p, dst)
        man[dst] = p
        save_json(QMAN, man)
        log(f"quarantined {p} -> {dst}")
    except Exception as e:
        log(f"quarantine fail {p}: {e}")

def audit_denials(pos):
    hits = []
    try:
        with open(AUDIT_LOG, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - 200000))
            data = f.read().decode(errors="replace")
        for ln in data.splitlines():
            if "apparmor=\"DENIED\"" in ln or "avc:  denied" in ln:
                hits.append(ln[-160:])
        return hits, size
    except Exception:
        return [], pos

class EWMA:
    def __init__(self):
        self.mean = 0.0
        self.var = 1.0
        self.n = 0
    def update(self, x):
        self.n += 1
        d = x - self.mean
        self.mean += ALPHA * d
        self.var = (1 - ALPHA) * (self.var + ALPHA * d * d)
    def z(self, x):
        s = math.sqrt(self.var)
        return 0 if s == 0 else abs(x - self.mean) / s

def main():
    baseline = load_json(STATE, {})
    suspects = load_json(SUSPECTS, {})
    rarity = load_json(RARITY, {"exec": [], "net": []})
    counts = collections.Counter(baseline.get("exec_counts", {}))
    ewma = {w: collections.defaultdict(EWMA) for w in WINDOWS}
    for w, table in baseline.get("ewma", {}).items():
        for k, v in table.items():
            e = EWMA()
            e.mean, e.var, e.n = v
            ewma[w][k] = e
    samples = baseline.get("samples", 0)
    fknown = baseline.get("files", {})
    try:
        with open(ALLOW) as f:
            allow = {l.strip() for l in f if l.strip() and not l.startswith("#")}
    except Exception:
        allow = set()
    self_hash = file_hash(SELF)
    try:
        with open("/proc/modules") as f:
            mod_known = set(l.split()[0] for l in f)
    except Exception:
        mod_known = set()
    net_known = net_conns()
    audit_pos = 0
    log(f"KZC v3 start samples={samples} suspects={len(suspects)}")
    tick = 0
    while True:
        try:
            tick += 1
            quiet = pacman_active()
            if tick % 36 == 0:
                for k in list(suspects):
                    suspects[k]["score"] = max(0, suspects[k]["score"] - 1)
                    if suspects[k]["score"] == 0 and time.time() - suspects[k]["last"] > 86400:
                        del suspects[k]
            if file_hash(SELF) != self_hash:
                alert("KZC binary modified, possible tampering", key="self")
            pairs, pids = proc_snapshot()
            samples += 1
            signals = collections.Counter()
            if not quiet:
                for pair, c in pairs.items():
                    key = f"{pair[0]}>{pair[1]}"
                    if key in allow:
                        continue
                    if key not in rarity["exec"]:
                        rarity["exec"].append(key)
                        signals[key] += 3
                        if samples > 20:
                            alert(f"first-seen exec {key}", key=f"fs:{key}")
                    for w in WINDOWS:
                        e = ewma[w][key]
                        z = e.z(c)
                        e.update(c)
                        if samples > 50 and z > Z_THRESH and c >= 2:
                            signals[key] += 2
                    prev = counts.get(key, 0)
                    counts[key] = prev + c
                for parents, childs, wgt, label in CHAIN:
                    for (pn, n), c in pairs.items():
                        if pn in parents and n in childs:
                            key = f"chain:{pn}>{n}"
                            signals[key] += wgt
                            alert(f"priv chain {label}: {pn}>{n}", key=key)
                            if n in ("bash", "sh", "zsh") and pn in ("librewolf", "wofi", "waybar"):
                                for pid, (pp, nn) in pids.items():
                                    if pp == pn and nn == n:
                                        try:
                                            os.kill(int(pid), 9)
                                        except Exception:
                                            pass
            try:
                with open("/proc/modules") as f:
                    cur = set(l.split()[0] for l in f)
                for m in cur - mod_known:
                    if m not in ("uvcvideo", "btusb", "iwlwifi", "nvidia"):
                        signals[f"module:{m}"] += 2
                        alert(f"new kernel module: {m}", key=f"mod:{m}")
                mod_known = cur
            except Exception:
                pass
            for remote in net_conns() - net_known:
                net_known.add(remote)
                if remote not in rarity["net"]:
                    rarity["net"].append(remote)
                    signals[f"net:{remote}"] += 3
            for ch in scan_persist(fknown):
                signals[ch] += 2
                if not quiet:
                    alert(f"persist change {ch}", key=f"persist:{ch}")
                if ch.startswith("new:") and ch.endswith((".sh", ".service", ".timer")):
                    quarantine(ch[4:])
            for hit in audit_denials(audit_pos)[0][-5:]:
                signals["apparmor"] += 2
                alert(f"confinement denial: {hit}", key=f"den:{hash(hit) % 9999}")
            for key, pts in signals.items():
                s = suspects.get(key, {"score": 0, "count": 0, "first": time.time(), "last": 0})
                s["score"] += pts
                s["count"] += 1
                s["last"] = time.time()
                suspects[key] = s
                if pts >= QUORUM * 2 and "chain" in key:
                    lock_session()
            try:
                for dev in os.listdir("/sys/block"):
                    if dev.startswith(("sd", "nvme")):
                        try:
                            with open(f"/sys/block/{dev}/device/uevent") as f:
                                if "USB" in f.read():
                                    alert(f"usb block device: {dev}", key=f"usb:{dev}")
                        except Exception:
                            pass
            except Exception:
                pass
            if samples % 12 == 0:
                save_json(STATE, {"exec_counts": dict(counts), "samples": samples, "files": fknown,
                                  "ewma": {w: {k: [e.mean, e.var, e.n] for k, e in t.items()} for w, t in ewma.items()}})
                save_json(SUSPECTS, suspects)
                save_json(RARITY, {"exec": rarity["exec"][-5000:], "net": rarity["net"][-2000:]})
            time.sleep(10)
        except Exception as e:
            log(f"loop err: {e}")
            time.sleep(10)

if __name__ == "__main__":
    sys.exit(main())
