#!/usr/bin/env bash
set -euo pipefail
# display - max resolution plus max refresh on every output at login
# usage: lamx-display (autostarted by both sessions)
if [ -n "${SWAYSOCK:-}" ] && command -v swaymsg >/dev/null; then
  swaymsg -t get_outputs | python3 -c "
import json, subprocess, sys
for o in json.load(sys.stdin):
    modes = o.get('modes', [])
    if not modes:
        continue
    m = max(modes, key=lambda m: (m['width'], m['height'], m.get('refresh', 0)))
    hz = m.get('refresh', 60000) / 1000
    subprocess.run(['swaymsg', 'output', o['name'], 'mode', f\"{m['width']}x{m['height']}@{hz:.0f}Hz\"])
    subprocess.run(['swaymsg', 'output', o['name'], 'adaptive_sync', 'on'])
    subprocess.run(['swaymsg', 'output', o['name'], 'scale', '1'])"
elif [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null; then
  hyprctl monitors -j | python3 -c "
import json, subprocess, sys
def key(s):
    res, hz = s.split('@')
    w, h = res.split('x')
    return (int(w), int(h), float(hz.replace('hz', '')))
for o in json.load(sys.stdin):
    ms = o.get('availableModes', [])
    if not ms:
        continue
    best = max(ms, key=key)
    w, h, r = key(best)
    subprocess.run(['hyprctl', 'keyword', 'monitor', '%s,%dx%d@%g,auto,1' % (o['name'], w, h, r)])
subprocess.run(['hyprctl', 'keyword', 'misc:vrr', '1'])"
fi
