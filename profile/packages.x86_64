# lamX package set - CachyOS base + SwayFX glassy, CLI-first
# all packages must exist in official or CachyOS repos, no AUR here
# AUR items like swaylock-effects and opencode-bin install post-boot via install.sh
# mandatory for archiso
mkinitcpio
mkinitcpio-archiso

# base
base
python
linux-cachyos-hardened
linux-firmware
intel-ucode
amd-ucode
cachyos-keyring
cachyos-mirrorlist
cachyos-v3-mirrorlist
audit
apparmor
bpftrace
libnotify

# boot
syslinux
efibootmgr
dosfstools

# single-user + login (passwordless-ready, no passwords stored)
greetd
greetd-tuigreet
shadow
systemd
tpm2-tss
libfido2
pam-u2f
oath-toolkit
libnewt
qrencode

# sway GUI, glassy via transparent apps on vanilla sway for ISO
# full blur via swayfx installed post-boot on target
# hyprland optional session for super smooth animations
sway
swaylock
swayidle
hyprland
hyprpaper
xdg-desktop-portal-hyprland
waybar
wofi
foot
mako
swaybg
xorg-xwayland
polkit
polkit-gnome
seatd
ttf-jetbrains-mono-nerd
ttf-dejavu
iptables
pipewire-jack
pipewire-alsa
crun

# CLI daily driver
yazi
neovim
git
curl
wget
htop
fd
fastfetch
networkmanager
iwd
wpa_supplicant
smartmontools
bubblewrap
nftables
chrony
openssh
librewolf
pipewire
pipewire-pulse
wireplumber
brightnessctl
grim
slurp
wl-clipboard
power-profiles-daemon

# 2 - updates and power, single stack
btrfs-progs
snapper
zram-generator
thermald
ananicy-cpp

# 4 - dev isolation
distrobox
podman
fuse-overlayfs

# VMs - QEMU best stack: quickemu CLI-first plus virt-manager full GUI
qemu-desktop
quickemu
virt-manager
libvirt
edk2-ovmf
swtpm
dnsmasq

# 5 - recovery
gnupg
rsync
cryptsetup

# sync and remote wake
syncthing
ethtool
wakeonlan

# drivers - generic Intel iGPU in ISO for boot everywhere
# AMD and Nvidia install on demand via setup GPU chooser
