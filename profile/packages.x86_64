# lamX package set - CachyOS base + SwayFX glassy, CLI-first
# all packages must exist in official or CachyOS repos, no AUR here
# AUR items like swaylock-effects and opencode-bin install post-boot via install.sh
# mandatory for archiso
mkinitcpio
mkinitcpio-archiso

# base
base
python
linux-cachyos-hardened
linux-firmware
intel-ucode
amd-ucode
cachyos-keyring
cachyos-mirrorlist
cachyos-v3-mirrorlist
audit
apparmor
bpftrace
fwupd
libnotify

# boot
syslinux
efibootmgr
dosfstools
parted

# single-user + login (passwordless-ready, no passwords stored)
greetd
greetd-tuigreet
shadow
sudo
systemd
tpm2-tss
libfido2
pam-u2f
oath-toolkit
libnewt
qrencode

# sway GUI, glassy via transparent apps on vanilla sway for ISO
# full blur via swayfx installed post-boot on target
# hyprland optional session for super smooth animations
sway
swaylock
swayidle
hyprland
xdg-desktop-portal
xdg-desktop-portal-hyprland
xdg-desktop-portal-wlr
xdg-utils
waybar
wofi
foot
mako
swaybg
xorg-xwayland
polkit
polkit-gnome
seatd
adwaita-icon-theme
ttf-dejavu
inter-font
noto-fonts
noto-fonts-emoji
iptables
pipewire-jack
pipewire-alsa

# CLI daily driver
yazi
neovim
zsh
zsh-completions
bash-completion
git
curl
man-db
man-pages
unzip
p7zip
htop
fd
plocate
fastfetch
networkmanager
iwd
iw
wpa_supplicant
smartmontools
psmisc
bubblewrap
nftables
wireguard-tools
chrony
openssh
hblock
librewolf
pipewire
pipewire-pulse
wireplumber
brightnessctl
grim
slurp
wl-clipboard
power-profiles-daemon

# 2 - updates and power, single stack
btrfs-progs
snapper
zram-generator
thermald
ananicy-cpp

# dev isolation and VMs install post-setup on demand, keeps ISO under limits
# see installer extras: distrobox podman fuse-overlayfs crun qemu-desktop
# quickemu virt-manager libvirt edk2-ovmf swtpm dnsmasq

# 5 - recovery
gnupg
rsync
cryptsetup

# sync and remote wake
syncthing
ethtool
wakeonlan

# drivers - generic Intel iGPU in ISO for boot everywhere
# AMD and Nvidia install on demand via setup GPU chooser
linux-cachyos-hardened-headers
linux-firmware-whence
sof-firmware
alsa-firmware
usbutils
pciutils
mesa
vulkan-icd-loader
vulkan-intel
intel-media-driver
egl-wayland
bluez
bluez-utils
kmod
v4l-utils
libcamera
gst-plugin-pipewire

# music - kernel-bound low-latency streaming, YouTube via mpv, no accounts
mpv
yt-dlp
ytfzf
fzf
ffmpeg
playerctl
